@{
    ViewData["Title"] = "Users Booking";
}
@model HallBookingBhatPara.Domain.DTO.MultipleModel

<!-- Header Section -->
<section class="booking-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1 class="booking-title">
                    <i class="fas fa-list-alt"></i> Users Bookings
                </h1>
                <p class="booking-subtitle">Manage and track all your hall bookings</p>
            </div>
        </div>
    </div>
</section>

<!-- Main Content Container -->
<div class="container allUsersbookingContainer">

    <!-- Filter Section -->
    <div class="filter-section">
        <div class="stats-controls-row">
            <div class="stats-bar">
                <div class="stat-compact">
                    <span class="stat-number-compact">0</span>
                    <span class="stat-label-compact">Total</span>
                </div>
                <div class="stat-compact">
                    <span class="stat-number-compact">0</span>
                    <span class="stat-label-compact">Confirmed</span>
                </div>
                <div class="stat-compact">
                    <span class="stat-number-compact">0</span>
                    <span class="stat-label-compact">Pending</span>
                </div>
                <div class="stat-compact">
                    <span class="stat-number-compact">0</span>
                    <span class="stat-label-compact">Completed</span>
                </div>
            </div>

            <!-- Advanced Search Button -->
            @* <button class="advanced-search-btn" id="openAdvancedSearch">
                <i class="fas fa-sliders-h"></i>
                Advanced Search
            </button> *@
        </div>        
    </div>

    <!-- Table Section -->
    <div class="table-section">       
        <!-- Responsive Table -->
        <div class="">
            <table class="table bookings-table" id="adminbookingsTable">
                <thead>
                    <tr>
                        <th scope="col">
                            <i class="fas fa-hashtag"></i> Sl
                        </th>
                        <th scope="col">
                            <i class="fas fa-hashtag"></i> Booking ID
                        </th>
                        <th scope="col">
                            <i class="fas fa-user"></i> User Details
                        </th>
                        <th scope="col">
                            <i class="fas fa-user"></i> Booked By
                        </th>
                        <th scope="col">
                            <i class="fas fa-building"></i> Hall Details
                        </th>
                        <th scope="col">
                            <i class="fas fa-calendar"></i> Event Info
                        </th>
                        <th scope="col">
                            <i class="fas fa-rupee-sign"></i> Amount
                        </th>
                        <th scope="col">
                            <i class="fas fa-info-circle"></i> Status
                        </th>
                        <th scope="col">
                            <i class="fas fa-cogs"></i> Actions
                        </th>
                    </tr>
                </thead>
                <tbody id="partialGetAllHallBooking">
                    
                    
                </tbody>
            </table>
        </div>

        @* <!-- Pagination -->
        <div class="pagination-container">
            <div class="pagination-info">
                Showing 1 to 6 of 156 entries
            </div>
            <nav aria-label="Bookings pagination">
                <ul class="pagination">
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                            <i class="fas fa-angle-left"></i> Previous
                        </a>
                    </li>
                    <li class="page-item active">
                        <a class="page-link" href="#">1</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">2</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">3</a>
                    </li>
                    <li class="page-item">
                        <span class="page-link">...</span>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">26</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">
                            Next <i class="fas fa-angle-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div> *@

    </div>

    <!-- Empty State (Hidden by default, show when no bookings) -->
    <div class="empty-state" id="emptyState" style="display: none;">
        <i class="fas fa-calendar-times"></i>
        <h3>No Bookings Found</h3>
        <p>No bookings match your current filter criteria. Try adjusting your filters or search terms.</p>
        <button class="search-new-btn">
            <i class="fas fa-refresh"></i> Reset Filters
        </button>
    </div>

</div>

<!-- Modal Overlay -->
<div class="modal-overlay" id="modalOverlay"></div>

<!-- Advanced Search Modal -->
<div class="advanced-search-modal" id="advancedSearchModal">
    <div class="modal-header-custom">
        <h4>
            <i class="fas fa-search-plus"></i>
            Advanced Search & Filters
        </h4>
        <button class="modal-close-btn" id="closeModal">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div class="modal-body-custom">
        <!-- Status Filter -->
        <div class="filter-group">
            <div class="filter-group-title">
                <i class="fas fa-filter"></i>
                Booking Status
            </div>
            <div class="status-checkboxes">
                <div class="status-checkbox-wrapper">
                    <input type="checkbox" id="statusAll" class="status-checkbox" checked>
                    <label for="statusAll" class="status-checkbox-label">
                        <i class="fas fa-list"></i>
                        All
                    </label>
                </div>
                <div class="status-checkbox-wrapper">
                    <input type="checkbox" id="statusConfirmed" class="status-checkbox">
                    <label for="statusConfirmed" class="status-checkbox-label">
                        <i class="fas fa-check-circle"></i>
                        Confirmed
                    </label>
                </div>
                <div class="status-checkbox-wrapper">
                    <input type="checkbox" id="statusPending" class="status-checkbox">
                    <label for="statusPending" class="status-checkbox-label">
                        <i class="fas fa-clock"></i>
                        Pending
                    </label>
                </div>
                <div class="status-checkbox-wrapper">
                    <input type="checkbox" id="statusCompleted" class="status-checkbox">
                    <label for="statusCompleted" class="status-checkbox-label">
                        <i class="fas fa-check-double"></i>
                        Completed
                    </label>
                </div>
                <div class="status-checkbox-wrapper">
                    <input type="checkbox" id="statusCancelled" class="status-checkbox">
                    <label for="statusCancelled" class="status-checkbox-label">
                        <i class="fas fa-times-circle"></i>
                        Cancelled
                    </label>
                </div>
            </div>
        </div>

        <!-- Date Range -->
        <div class="filter-group">
            <div class="filter-group-title">
                <i class="fas fa-calendar-range"></i>
                Date Range
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="fromDate" class="form-label">
                        <i class="fas fa-calendar-alt"></i> From Date
                    </label>
                    <input type="date" id="fromDate" class="form-control">
                </div>
                <div class="col-md-6">
                    <label for="toDate" class="form-label">
                        <i class="fas fa-calendar-check"></i> To Date
                    </label>
                    <input type="date" id="toDate" class="form-control">
                </div>
            </div>
        </div>

        <!-- Hall Search -->
        <div class="filter-group">
            <div class="filter-group-title">
                <i class="fas fa-building"></i>
                Search by Hall
            </div>
            <input type="text" id="searchHall" class="form-control" placeholder="Enter hall name...">
        </div>
    </div>

    <div class="modal-footer-custom">
        <button class="btn-reset" id="resetFilters">
            <i class="fas fa-redo"></i> Reset
        </button>
        <button class="btn-apply" id="applyFilters">
            <i class="fas fa-check"></i> Apply Filters
        </button>
    </div>
</div>


<!-- Detailed Booking Modal -->
<div class="modal fade" id="bookingDetailsModal" tabindex="-1" aria-labelledby="bookingDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bookingDetailsModalLabel">
                    <i class="fas fa-info-circle text-primary"></i>
                    <span id="modalBookingId">Booking Details</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row" id="partialBookedHallDetails">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Close
                </button>
                @* <button type="button" class="btn btn-primary" id="modalDownloadBtn">
                    <i class="fas fa-download"></i> Download Receipt
                </button>
                <button type="button" class="btn btn-success" id="modalPrintBtn">
                    <i class="fas fa-print"></i> Print Details
                </button> *@
            </div>
        </div>
    </div>
</div>