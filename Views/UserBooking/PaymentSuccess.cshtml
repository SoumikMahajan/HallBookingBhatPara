@using HallBookingBhatPara.Domain.DTO.CashFreePayment
@model PaymentResultViewModel
@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-lg">
                <div class="card-body text-center p-5">
                    <!-- Success Icon -->
                    <div class="success-icon mb-4">
                        <div class="success-checkmark">
                            <div class="check-icon">
                                <span class="icon-line line-tip"></span>
                                <span class="icon-line line-long"></span>
                                <div class="icon-circle"></div>
                                <div class="icon-fix"></div>
                            </div>
                        </div>
                    </div>

                    <h2 class="text-success fw-bold mb-3">Payment Successful!</h2>
                    <p class="text-muted mb-4">
                        Thank you for your booking. Your payment has been processed successfully.
                    </p>

                    <!-- Payment Details -->
                    <div class="payment-details bg-light rounded p-4 mb-4">
                        <div class="row mb-3">
                            <div class="col-6 text-start">
                                <strong>Booking ID:</strong>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-primary fw-semibold">@Model.BookingId</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6 text-start">
                                <strong>Order ID:</strong>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-muted">@Model.OrderId</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6 text-start">
                                <strong>Transaction ID:</strong>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-muted small">@Model.TransactionId</span>
                            </div>
                        </div>
                        <hr class="my-3">
                        <div class="row">
                            <div class="col-6 text-start">
                                <strong>Amount Paid:</strong>
                            </div>
                            <div class="col-6 text-end">
                                <h5 class="text-success mb-0">₹@Model.Amount.ToString("N2")</h5>
                            </div>
                        </div>
                    </div>

                    <!-- Confirmation Message -->
                    <div class="alert alert-info mb-4">
                        <i class="fas fa-info-circle me-2"></i>
                        A confirmation email has been sent to your registered email address with booking details.
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-3">
                        @* <a href="@Url.Action("BookingDetails", "UserBooking", new { id = Model.BookingId })"
                           class="btn btn-primary btn-lg">
                            <i class="fas fa-file-alt me-2"></i>View Booking Details
                        </a> *@
                        <a href="@Url.Action("BookingList", "UserBooking")"
                           class="btn btn-outline-secondary">
                            <i class="fas fa-list me-2"></i>View All Bookings
                        </a>
                        <a href="@Url.Action("Index", "Home")"
                           class="btn btn-link text-muted">
                            <i class="fas fa-home me-2"></i>Return to Home
                        </a>
                    </div>

                    <!-- Support Note -->
                    <div class="mt-4 pt-4 border-top">
                        <p class="small text-muted mb-0">
                            Need help? Contact our support team at
                            <a href="mailto:support@yourdomain.com">support@yourdomain.com</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Success Animation Styles */
    .success-checkmark {
        width: 80px;
        height: 80px;
        margin: 0 auto;
    }

    .check-icon {
        width: 80px;
        height: 80px;
        position: relative;
        border-radius: 50%;
        box-sizing: content-box;
        border: 4px solid #28a745;
    }

    .icon-line {
        height: 5px;
        background-color: #28a745;
        display: block;
        border-radius: 2px;
        position: absolute;
        z-index: 10;
    }

    .line-tip {
        top: 46px;
        left: 14px;
        width: 25px;
        transform: rotate(45deg);
        animation: checkmark-tip 0.75s;
    }

    .line-long {
        top: 38px;
        right: 8px;
        width: 47px;
        transform: rotate(-45deg);
        animation: checkmark-long 0.75s;
    }

    .icon-circle {
        top: -4px;
        left: -4px;
        z-index: 10;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        position: absolute;
        box-sizing: content-box;
        border: 4px solid rgba(40, 167, 69, 0.2);
    }

    .icon-fix {
        top: 8px;
        width: 5px;
        left: 26px;
        z-index: 1;
        height: 85px;
        position: absolute;
        transform: rotate(-45deg);
        background-color: #fff;
    }

    @@keyframes checkmark-tip {
        0% {
            width: 0;
            left: 1px;
            top: 19px;
        }
        54% {
            width: 0;
            left: 1px;
            top: 19px;
        }
        70% {
            width: 50px;
            left: -8px;
            top: 37px;
        }
        84% {
            width: 17px;
            left: 21px;
            top: 48px;
        }
        100% {
            width: 25px;
            left: 14px;
            top: 45px;
        }
    }

    @@keyframes checkmark-long {
        0% {
            width: 0;
            right: 46px;
            top: 54px;
        }
        65% {
            width: 0;
            right: 46px;
            top: 54px;
        }
        84% {
            width: 55px;
            right: 0;
            top: 35px;
        }
        100% {
            width: 47px;
            right: 8px;
            top: 38px;
        }
    }

    .card {
        animation: fadeInUp 0.5s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>