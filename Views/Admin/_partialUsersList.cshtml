@model HallBookingBhatPara.Domain.DTO.MultipleModel

@if (Model?.User_List_Admin != null && Model.User_List_Admin.Any())
{
    @foreach (var item in Model.User_List_Admin)
    {
        <tr>
            <td>
                <strong>@item.user_name</strong>
            </td>
            <td>
                <strong>@item.email</strong>
            </td>
            <td>
                <strong>@item.mobile</strong>
            </td>
            <td>
                <strong>@item.city</strong>
            </td>
            <td>
                <strong>@item.pin</strong>
            </td>
            <td>
                <strong>@item.role_name</strong>
            </td>
            <td>
                <div class="table-action-buttons">
                    <button class="table-action-btn table-btn-edit editUser" data-userid="@item.user_id_pk" data-roleid="@item.role_id">
                        <i class="fas fa-edit"></i>
                        Edit
                    </button>
                    @if (User.Identity.IsAuthenticated && !User.IsInRole("Counter Admin"))
                    {
                        <button class="table-action-btn table-btn-view ChangePassword" data-userid="@item.user_id_pk" data-emailid="@item.email">
                            <i class="fas fa-key"></i>
                            Change Password
                        </button>
                    }
                    
                </div>
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="7" class="text-center">No Booking found</td>
    </tr>
}