@using HallBookingBhatPara.Domain.DTO.CashFreePayment
@model PaymentResultViewModel
@{
    ViewData["Title"] = "Payment Failed";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-lg">
                <div class="card-body text-center p-5">
                    <!-- Failure Icon -->
                    <div class="failure-icon mb-4">
                        <div class="error-circle">
                            <div class="error-icon">
                                <span class="error-line error-line-left"></span>
                                <span class="error-line error-line-right"></span>
                            </div>
                        </div>
                    </div>

                    <h2 class="text-danger fw-bold mb-3">Payment Failed</h2>
                    <p class="text-muted mb-4">
                        @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
                        {
                            @Model.ErrorMessage
                        }
                        else
                        {
                            <text>Unfortunately, we couldn't process your payment. Please try again.</text>
                        }
                    </p>

                    <!-- Payment Details (if available) -->
                    @if (!string.IsNullOrEmpty(Model?.OrderId))
                    {
                        <div class="payment-details bg-light rounded p-4 mb-4">
                            <div class="row mb-2">
                                <div class="col-6 text-start">
                                    <strong>Order ID:</strong>
                                </div>
                                <div class="col-6 text-end">
                                    <span class="text-muted">@Model.OrderId</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Status))
                            {
                                <div class="row">
                                    <div class="col-6 text-start">
                                        <strong>Status:</strong>
                                    </div>
                                    <div class="col-6 text-end">
                                        <span class="badge bg-danger">@Model.Status</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Common Reasons -->
                    <div class="alert alert-warning text-start mb-4">
                        <h6 class="alert-heading">
                            <i class="fas fa-exclamation-triangle me-2"></i>Common Reasons for Payment Failure:
                        </h6>
                        <ul class="mb-0 small">
                            <li>Insufficient funds in your account</li>
                            <li>Incorrect card details or CVV</li>
                            <li>Card expired or blocked</li>
                            <li>Transaction timeout due to network issues</li>
                            <li>Daily transaction limit exceeded</li>
                        </ul>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-3">
                        <button onclick="history.back()" class="btn btn-primary btn-lg">
                            <i class="fas fa-redo me-2"></i>Try Again
                        </button>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                            <i class="fas fa-home me-2"></i>Return to Home
                        </a>
                        <a href="@Url.Action("ContactSupport", "Support")" class="btn btn-link text-muted">
                            <i class="fas fa-headset me-2"></i>Contact Support
                        </a>
                    </div>

                    <!-- Support Information -->
                    <div class="mt-4 pt-4 border-top">
                        <h6 class="fw-semibold mb-3">Need Help?</h6>
                        <p class="small text-muted mb-2">
                            Our support team is available 24/7 to assist you
                        </p>
                        <div class="d-flex justify-content-center gap-3 flex-wrap">
                            <a href="mailto:support@yourdomain.com" class="text-decoration-none">
                                <i class="fas fa-envelope text-primary me-1"></i>
                                <small>support@yourdomain.com</small>
                            </a>
                            <a href="tel:+911234567890" class="text-decoration-none">
                                <i class="fas fa-phone text-success me-1"></i>
                                <small>+91 123-456-7890</small>
                            </a>
                        </div>
                    </div>

                    <!-- Reference Note -->
                    @if (!string.IsNullOrEmpty(Model?.OrderId))
                    {
                        <div class="mt-3">
                            <small class="text-muted">
                                Please quote Order ID <strong>@Model.OrderId</strong> when contacting support
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Failure Animation Styles */
    .failure-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto;
    }

    .error-circle {
        width: 80px;
        height: 80px;
        position: relative;
        border-radius: 50%;
        box-sizing: content-box;
        border: 4px solid #dc3545;
        animation: scaleIn 0.5s ease-out;
    }

    .error-icon {
        width: 80px;
        height: 80px;
        position: relative;
    }

    .error-line {
        height: 5px;
        background-color: #dc3545;
        display: block;
        border-radius: 2px;
        position: absolute;
        z-index: 10;
        top: 37px;
        width: 47px;
    }

    .error-line-left {
        left: 17px;
        transform: rotate(45deg);
        animation: error-line-animate 0.75s;
    }

    .error-line-right {
        right: 16px;
        transform: rotate(-45deg);
        animation: error-line-animate 0.75s;
    }

    @@keyframes scaleIn {
        0% {
            transform: scale(0);
            opacity: 0;
        }

        50% {
            transform: scale(1.1);
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes error-line-animate {
        0% {
            width: 0;
        }

        100% {
            width: 47px;
        }
    }

    .card {
        animation: fadeInUp 0.5s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .alert-warning {
        background-color: #fff3cd;
        border-color: #ffc107;
    }
</style>
