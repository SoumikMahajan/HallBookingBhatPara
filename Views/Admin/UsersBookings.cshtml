<!-- Modal Overlay -->
<div class="modal-overlay" id="modalOverlay"></div>

<!-- Advanced Search Modal -->
<div class="advanced-search-modal" id="advancedSearchModal">
    <div class="modal-header-custom">
        <h4>
            <i class="fas fa-search-plus"></i>
            Advanced Search & Filters
        </h4>
        <button class="modal-close-btn" id="closeModal">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div class="modal-body-custom">
        <!-- Status Filter -->
        <div class="filter-group">
            <div class="filter-group-title">
                <i class="fas fa-filter"></i>
                Booking Status
            </div>
            <div class="status-checkboxes">
                <div class="status-checkbox-wrapper">
                    <input type="checkbox" id="statusAll" class="status-checkbox" checked>
                    <label for="statusAll" class="status-checkbox-label">
                        <i class="fas fa-list"></i>
                        All
                    </label>
                </div>
                <div class="status-checkbox-wrapper">
                    <input type="checkbox" id="statusConfirmed" class="status-checkbox">
                    <label for="statusConfirmed" class="status-checkbox-label">
                        <i class="fas fa-check-circle"></i>
                        Confirmed
                    </label>
                </div>
                <div class="status-checkbox-wrapper">
                    <input type="checkbox" id="statusPending" class="status-checkbox">
                    <label for="statusPending" class="status-checkbox-label">
                        <i class="fas fa-clock"></i>
                        Pending
                    </label>
                </div>
                <div class="status-checkbox-wrapper">
                    <input type="checkbox" id="statusCompleted" class="status-checkbox">
                    <label for="statusCompleted" class="status-checkbox-label">
                        <i class="fas fa-check-double"></i>
                        Completed
                    </label>
                </div>
                <div class="status-checkbox-wrapper">
                    <input type="checkbox" id="statusCancelled" class="status-checkbox">
                    <label for="statusCancelled" class="status-checkbox-label">
                        <i class="fas fa-times-circle"></i>
                        Cancelled
                    </label>
                </div>
            </div>
        </div>

        <!-- Date Range -->
        <div class="filter-group">
            <div class="filter-group-title">
                <i class="fas fa-calendar-range"></i>
                Date Range
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="fromDate" class="form-label">
                        <i class="fas fa-calendar-alt"></i> From Date
                    </label>
                    <input type="date" id="fromDate" class="form-control">
                </div>
                <div class="col-md-6">
                    <label for="toDate" class="form-label">
                        <i class="fas fa-calendar-check"></i> To Date
                    </label>
                    <input type="date" id="toDate" class="form-control">
                </div>
            </div>
        </div>

        <!-- Hall Search -->
        <div class="filter-group">
            <div class="filter-group-title">
                <i class="fas fa-building"></i>
                Search by Hall
            </div>
            <input type="text" id="searchHall" class="form-control" placeholder="Enter hall name...">
        </div>
    </div>

    <div class="modal-footer-custom">
        <button class="btn-reset" id="resetFilters">
            <i class="fas fa-redo"></i> Reset
        </button>
        <button class="btn-apply" id="applyFilters">
            <i class="fas fa-check"></i> Apply Filters
        </button>
    </div>
</div>