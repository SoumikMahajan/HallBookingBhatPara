@model HallBookingBhatPara.Domain.DTO.MultipleModel

@{
    var bookingDetails = Model.bookedDetailsById;
    var HallName = $"{bookingDetails.category_name} - {bookingDetails.hall_name}";
}

<!-- Hall Information -->
<div class="col-lg-6 mb-4">
    <div class="card h-100">
        <div class="card-header bg-primary text-white">
            <h6 class="mb-0"><i class="fas fa-building"></i> Hall Information</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-bold">Hall Name</label>
                    <p class="mb-2" id="modalHallName">@HallName</p>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Floor</label>
                    <p class="mb-2" id="modalFloorName">@(string.IsNullOrWhiteSpace(bookingDetails.floor_name) ? "NA" : bookingDetails.floor_name)</p>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Capacity</label>
                    <p class="mb-2" id="modalCapacity">NA</p>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">Facilities</label>
                    <p class="mb-2" id="modalFacilities">NA</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Event Information -->
<div class="col-lg-6 mb-4">
    <div class="card h-100">
        <div class="card-header bg-success text-white">
            <h6 class="mb-0"><i class="fas fa-calendar-alt"></i> Event Information</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6">
                    <label class="form-label fw-bold">Event Date</label>
                    <p class="mb-2" id="modalEventDate">@bookingDetails.booking_date_range</p>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Event Type</label>
                    <p class="mb-2" id="modalEventType">@bookingDetails.event_type_name</p>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Start Time</label>
                    <p class="mb-2" id="modalStartTime">NA</p>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">End Time</label>
                    <p class="mb-2" id="modalEndTime">NA</p>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">Event Description</label>
                    <p class="mb-2" id="modalEventDescription">NA</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Booking Information -->
<div class="col-lg-6 mb-4">
    <div class="card h-100">
        <div class="card-header bg-info text-white">
            <h6 class="mb-0"><i class="fas fa-clipboard-list"></i> Booking Information</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6">
                    <label class="form-label fw-bold">Booking ID</label>
                    <p class="mb-2" id="modalBookingIdInfo">@bookingDetails.booking_reference_id</p>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Booked On</label>
                    <p class="mb-2" id="modalBookedOn">@bookingDetails.user_booked_on</p>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Booking Status</label>
                    <span class="badge bg-success" id="modalBookingStatus">@bookingDetails.booking_process_name</span>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Payment Status</label>
                    <span class="badge bg-success" id="modalPaymentStatus">
                        @* 100% Complete *@ NA
                    </span>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">Special Requirements</label>
                    <p class="mb-2" id="modalRequirements">NA</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Payment Information -->
<div class="col-lg-6 mb-4">
    <div class="card h-100">
        <div class="card-header bg-warning text-white">
            <h6 class="mb-0"><i class="fas fa-rupee-sign"></i> Payment Information</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6">
                    <label class="form-label fw-bold">Hall Rent</label>
                    <p class="mb-2" id="modalHallRent">₹@bookingDetails.total_price_summary_amount</p>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Additional Services</label>
                    <p class="mb-2" id="modalAdditionalServices">NA</p>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Security Deposit</label>
                    <p class="mb-2" id="modalSecurityDeposit">NA</p>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Total Amount</label>
                    <h5 class="text-primary mb-2" id="modalTotalAmount">₹@bookingDetails.total_price_summary_amount</h5>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Paid Amount</label>
                    <p class="mb-2 text-success" id="modalPaidAmount">₹@bookingDetails.total_price_summary_amount</p>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Remaining Amount</label>
                    <p class="mb-2" id="modalRemainingAmount">₹@bookingDetails.remaining_payment_amount</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contact Information -->
<div class="col-lg-12 mb-4">
    <div class="card">
        <div class="card-header bg-secondary text-white">
            <h6 class="mb-0"><i class="fas fa-user"></i> Contact Information</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Primary Contact</label>
                    <p class="mb-2" id="modalPrimaryContact">@bookingDetails.user_name</p>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Phone Number</label>
                    <p class="mb-2" id="modalPhoneNumber">+91 @bookingDetails.mobile</p>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Email</label>
                    <p class="mb-2" id="modalEmail">@bookingDetails.email</p>
                </div>
            </div>
        </div>
    </div>
</div>


@if (!string.IsNullOrEmpty(@bookingDetails.booked_by_admin_name) || !string.IsNullOrEmpty(@bookingDetails.booked_by_admin_email))
{
    <!-- Contact Information -->
    <div class="col-lg-12 mb-4">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0"><i class="fas fa-user"></i> Booked By Information</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Primary Contact</label>
                        <p class="mb-2" id="modalPrimaryContact">@bookingDetails.booked_by_admin_name</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Phone Number</label>
                        <p class="mb-2" id="modalPhoneNumber">+91 @bookingDetails.booked_by_admin_email</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Email</label>
                        <p class="mb-2" id="modalEmail">@bookingDetails.booked_by_admin_mobile</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

