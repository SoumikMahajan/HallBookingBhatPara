@model HallBookingBhatPara.Domain.DTO.MultipleModel
<!-- Bookings Grid Section -->
@if (Model.bookedListDTOs.Count > 0)
{
    <section class="bookings-section">
        <div class="container">
            <div class="bookings-grid" id="bookingsGrid">
                @foreach (var item in Model.bookedListDTOs)
                {
                    var HallName = $"{@item.category_name} - {item.hall_name} ";
                    if (item.booking_process_status_id == 5)
                    {
                        <!-- Booking Card  - Confirmed -->
                        <div class="booking-card" data-booking-id="@item.booking_reference_id">
                            <div class="booking-list-header">
                                <div class="booking-id">#@item.booking_reference_id</div>
                                <h4 class="hall-name">@HallName</h4>
                                <div class="booking-status status-confirmed">@item.booking_process_name.ToUpper()</div>
                            </div>

                            <div class="booking-body">
                                <div class="booking-details">
                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-calendar"></i>
                                        </div>
                                        <span><strong>Event Date:</strong> @item.booking_date_range</span>
                                    </div>

                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-tag"></i>
                                        </div>
                                        <span><strong>Event Type:</strong> @item.event_type_name</span>
                                    </div>

                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-rupee-sign"></i>
                                        </div>
                                        <span><strong>Total Amount:</strong> ₹@item.total_price_summary_amount</span>
                                    </div>
                                </div>

                                <div class="booking-actions">
                                    <button class="action-btn-bookinglist btn-view btnHallBookedDetails" data-hallid="@item.hall_booking_id_pk" data-hallname="@HallName">
                                        <i class="fas fa-eye"></i> View Details
                                    </button>
                                    <button class="action-btn-bookinglist btn-download">
                                        <i class="fas fa-download"></i> Download
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (item.booking_process_status_id == 3)
                    {
                        <!-- Booking Card 2 - Approved -->
                        <div class="booking-card" data-booking-id="@item.booking_reference_id">
                            <div class="booking-list-header">
                                <div class="booking-id">#@item.booking_reference_id</div>
                                <h4 class="hall-name">@HallName</h4>
                                <div class="booking-status status-approved">@item.booking_process_name.ToUpper()</div>
                            </div>
                
                            <div class="booking-body">
                                <div class="booking-details">
                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-calendar"></i>
                                        </div>
                                        <span><strong>Event Date:</strong> @item.booking_date_range</span>
                                    </div>
                        
                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-tag"></i>
                                        </div>
                                        <span><strong>Event Type:</strong> @item.event_type_name</span>
                                    </div>
                        
                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-rupee-sign"></i>
                                        </div>
                                        <span><strong>Total Amount:</strong> ₹@item.total_price_summary_amount</span>
                                    </div>
                        
                                    <div class="detail-item payment-pending">
                                        <div class="detail-icon">
                                            <i class="fas fa-exclamation-triangle"></i>
                                        </div>
                                        <span><strong>Payment:</strong> <!--75% Complete - ₹1500 Due-->- ₹@item.total_price_summary_amount</span>
                                    </div>
                                </div>
                    
                                <div class="booking-actions">
                                    <button class="action-btn-bookinglist btn-view btnHallBookedDetails" data-hallid="@item.hall_booking_id_pk" data-hallname="@HallName">
                                        <i class="fas fa-eye"></i> View Details
                                    </button>
                                    <button class="action-btn-bookinglist btn-payment" data-hallid="@item.hall_booking_id_pk">
                                        <i class="fas fa-eye"></i> Make Payment
                                    </button>                                   
                                </div>
                            </div>
                        </div>

                    }
                    else if (item.booking_process_status_id == 1)
                    {
                        <!-- Booking Card 5 - Pending -->
                        <div class="booking-card" data-booking-id="@item.booking_reference_id">
                            <div class="booking-list-header">
                                <div class="booking-id">#@item.booking_reference_id</div>
                                <h4 class="hall-name">@HallName</h4>
                                <div class="booking-status status-pending">@item.booking_process_name.ToUpper()</div>
                            </div>
                
                            <div class="booking-body">
                                <div class="booking-details">
                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-calendar"></i>
                                        </div>
                                        <span><strong>Event Date:</strong> @item.booking_date_range</span>
                                    </div>
                        
                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-tag"></i>
                                        </div>
                                        <span><strong>Event Type:</strong> @item.event_type_name</span>
                                    </div>
                        
                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-rupee-sign"></i>
                                        </div>
                                        <span><strong>Total Amount:</strong> ₹@item.total_price_summary_amount</span>
                                    </div>
                                </div>
                    
                                <div class="booking-actions">
                                    <button class="action-btn-bookinglist btn-view btnHallBookedDetails" data-hallid="@item.hall_booking_id_pk" data-hallname="@HallName">
                                        <i class="fas fa-eye"></i> View Details
                                    </button>
                                    @* <button class="action-btn-bookinglist btn-cancel">
                                        <i class="fas fa-times"></i> Cancel
                                    </button> *@
                                </div>
                            </div>
                        </div>
                    }
                    else if (item.booking_process_status_id == 6)
                    {
                        <!-- Booking Card 5 - Reject -->
                        <div class="booking-card" data-booking-id="@item.booking_reference_id">
                            <div class="booking-list-header">
                                <div class="booking-id">#@item.booking_reference_id</div>
                                <h4 class="hall-name">@HallName</h4>
                                <div class="booking-status status-cancelled">@item.booking_process_name.ToUpper()</div>
                            </div>

                            <div class="booking-body">
                                <div class="booking-details">
                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-calendar"></i>
                                        </div>
                                        <span><strong>Event Date:</strong> @item.booking_date_range</span>
                                    </div>

                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-tag"></i>
                                        </div>
                                        <span><strong>Event Type:</strong> @item.event_type_name</span>
                                    </div>

                                    <div class="detail-item">
                                        <div class="detail-icon">
                                            <i class="fas fa-rupee-sign"></i>
                                        </div>
                                        <span><strong>Total Amount:</strong> ₹@item.total_price_summary_amount</span>
                                    </div>
                                </div>

                                <div class="booking-actions">
                                    <button class="action-btn-bookinglist btn-view btnHallBookedDetails" data-hallid="@item.hall_booking_id_pk" data-hallname="@HallName">
                                        <i class="fas fa-eye"></i> View Details
                                    </button>
                                    @* <button class="action-btn-bookinglist btn-cancel">
                                        <i class="fas fa-times"></i> Cancel
                                    </button> *@
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
}
else
{
    <!-- Empty State (Hidden by default, show when no bookings) -->
    <div class="empty-state" id="emptyState">
        <i class="fas fa-calendar-times"></i>
        <h3>No Bookings Found</h3>
        <p>You haven't made any bookings yet. Start by searching for available halls.</p>       
    </div>
}